# ===================================================================
# CC+ (Colab-Command-Center) — environment template
# Copy to .env and fill in real values. Never commit .env.
# On Render, set these as environment variables.
# ===================================================================

# --- Gemini (CC R1) — fast/light model, 2 keys, 14 req/min each ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash

# --- Primary provider (CC R2 / primary) — code/bug/problem fix, 2 keys, 10 req/min each ---
# Uses the b.ai endpoint; model is deepseek-v4-flash.
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_BASE_URL=https://api.b.ai/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# --- NVIDIA (CC R3 / fallback) — 2 keys, fallback models ---
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_FALLBACK_MODELS=deepseek-ai/deepseek-v4-flash-0731,openai/gpt-oss-120b,meta/llama-3.1-70b-instruct

# --- GitHub (project save) ---
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# --- Kaggle (optional Kaggle server connector) ---
KAGGLE_API_KEY=

# --- App ---
APP_NAME=CC+
APP_OCCUPANCY_LOCK=true
LOG_LEVEL=info
